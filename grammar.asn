    ;; Extended Operations (> 2 tokens with required :rationale)
    (:sym :name "standard-coding-tools" :kind :fn :tokens 3
          :rationale "Factory returning the standard suite of direct agent coding tools")
    (:sym :name "execute-builtin-tool" :kind :fn :tokens 3
          :rationale "Direct execution dispatcher for built-in capability tools without subprocesses")
    (:sym :name "format-tool-result" :kind :fn :tokens 3
          :rationale "Formats tool execution payload into concise agent observation string")
    (:sym :name "should-execute-locally" :kind :fn :tokens 3
          :rationale "Router predicate identifying deterministic tools executable without LLM roundtrip")
    (:sym :name "route-and-execute" :kind :fn :tokens 3
          :rationale "Direct router executing tools in optimal execution tier")
    (:sym :name "format-savings-report" :kind :fn :tokens 3
          :rationale "Telemetry generator calculating token and latency savings from local execution")
    (:sym :name "normalize-asl-fragment" :kind :fn :tokens 3
          :rationale "Multi-step normalization pipeline repairing hallucinated ASL code fragments")
    (:sym :name "default-gateway-config" :kind :fn :tokens 3
          :rationale "Default configuration provider targeting LLM Gateway endpoint")
    (:sym :name "build-request-payload" :kind :fn :tokens 3
          :rationale "Serializes chat messages and tools into OpenAI-compatible request JSON")
