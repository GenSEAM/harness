          :sample-input "(:generate-flowchart :steps [\"Perception\" \"Planning\" \"Reconciliation\"])"
          :sample-output "(:svg :v \"0 0 600 160\" (:rc :x 20 :y 40 :w 140 :h 80 :rx 8 :f \"#0f172a\" :s \"#38bdf8\" :sw 2) (:txt :x 90 :y 85 :sz 14 :f \"#f8fafc\" :anch :mid \"Perception\") (:p :d \"M 160 80 L 220 80\" :s \"#94a3b8\" :sw 2) (:rc :x 220 :y 40 :w 140 :h 80 :rx 8 :f \"#0f172a\" :s \"#818cf8\" :sw 2) (:txt :x 290 :y 85 :sz 14 :f \"#f8fafc\" :anch :mid \"Planning\") (:p :d \"M 360 80 L 420 80\" :s \"#94a3b8\" :sw 2) (:rc :x 420 :y 40 :w 140 :h 80 :rx 8 :f \"#0f172a\" :s \"#4ade80\" :sw 2) (:txt :x 490 :y 85 :sz 14 :f \"#f8fafc\" :anch :mid \"Reconciliation\"))"
          :fidelity-pct 97.5
          :impossibility "Automatic force-directed graph node collision avoidance with N > 20 nodes")
        (:preset
