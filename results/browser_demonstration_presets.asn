          :kind "vector-badge"
          :spec "Vector security shield with dual-ring perimeter, centered checkmark path, and status subtitle"
          :sample-input "(:generate-shield-badge :title \"GATE VERIFIED\" :subtitle \"35 Assertions Clean\")"
          :sample-output "(:svg :v \"0 0 200 200\" (:rc :x 10 :y 10 :w 180 :h 180 :rx 16 :f \"#0f172a\" :s \"#38bdf8\" :sw 2) (:circ :cx 100 :cy 85 :r 45 :f \"#1e293b\" :s \"#38bdf8\" :sw 2) (:p :d \"M 85 85 L 95 95 L 115 75\" :s \"#4ade80\" :sw 4 :f \"none\") (:txt :x 100 :y 155 :sz 14 :f \"#f8fafc\" :anch :mid \"GATE VERIFIED\") (:txt :x 100 :y 175 :sz 11 :f \"#94a3b8\" :anch :mid \"35 Assertions Clean\"))"
          :fidelity-pct 98.5
          :impossibility "Complex photographic ray-traced lighting simulation")
