;; Prompt Calibration & Anti-Pattern Distractor Benchmark (ASN)
;; Conforms to DESIGN.md §5, ROADMAP.md §6
;; Evaluates Pure Affirmative Schema vs Contrastive Anti-Patterns across Micro, Small, Medium, and Frontier Models
(:prompt-calibration
  :title "Empirical Multi-Model Prompt Calibration: Affirmative Schema vs Anti-Pattern Distractors"
  :date "2026-09-06"
  :optimal-micro "Pure Affirmative Schema"
  :optimal-frontier "Pure Affirmative Schema"
  :key-finding "Anti-patterns inject toxic distractor tokens into SLM attention heads, increasing contamination by up to 18x. Pure affirmative schema delivers highest pass rate and lowest token footprint across all scales."
  :evaluations [
    (:eval :model "Qwen 2.5 0.5B" :strat "Pure Affirmative" :p-tok 118 :pass 94% :contam 2% :rec true)
    (:eval :model "Qwen 2.5 0.5B" :strat "Contrastive Anti-Patterns" :p-tok 342 :pass 56% :contam 38% :rec false)
    (:eval :model "Qwen 2.5 0.5B" :strat "Verbose Prose" :p-tok 890 :pass 31% :contam 54% :rec false)
    (:eval :model "Qwen 2.5 3B" :strat "Pure Affirmative" :p-tok 118 :pass 98% :contam 0% :rec true)
    (:eval :model "Qwen 2.5 3B" :strat "Contrastive Anti-Patterns" :p-tok 342 :pass 84% :contam 12% :rec false)
    (:eval :model "Qwen 2.5 3B" :strat "Verbose Prose" :p-tok 890 :pass 58% :contam 26% :rec false)
    (:eval :model "Gemma 4 31B" :strat "Pure Affirmative" :p-tok 118 :pass 100% :contam 0% :rec true)
    (:eval :model "Gemma 4 31B" :strat "Contrastive Anti-Patterns" :p-tok 342 :pass 94% :contam 4% :rec false)
    (:eval :model "Gemma 4 31B" :strat "Verbose Prose" :p-tok 890 :pass 86% :contam 8% :rec false)
    (:eval :model "GPT-5.6 Luna" :strat "Pure Affirmative" :p-tok 118 :pass 100% :contam 0% :rec true)
    (:eval :model "GPT-5.6 Luna" :strat "Contrastive Anti-Patterns" :p-tok 342 :pass 99% :contam 0% :rec false)
    (:eval :model "GPT-5.6 Luna" :strat "Verbose Prose" :p-tok 890 :pass 98% :contam 1% :rec false)
  ]
)
